{
  "schemaVersion": 1,
  "description": "Registry (not a catalog) of legacy GeneXus export elements (GeneXus 8/9 XML, and GeneXus 7.0 and earlier .xpw translated to the same shape) (ExportFile with <GXObject><Elemento> identified by element NAME, no type GUID). Representation/governance layer: classifies each legacy element as 'equivalent' (has a real modern type in the catalog) or 'orphan' (no modern equivalent, materialized in its own folder with typeToken gxlegacy/<Elemento>). The export/materialization engine is separate and confirms exact tag/casing when parsing real GX9. Doc owner: 01k-legacy-element-registry.md.",
  "elements": {
    "Transaction": { "class": "equivalent", "catalogType": "Transaction" },
    "StructureDataType": { "class": "equivalent", "catalogType": "SDT" },
    "Language": { "class": "equivalent", "catalogType": "Language" },
    "Table": { "class": "equivalent", "catalogType": "Table" },
    "Theme": { "class": "equivalent", "catalogType": "Theme" },
    "Folder": { "class": "equivalent", "catalogType": "Folder" },
    "WorkPanel": { "class": "equivalent", "catalogType": "WorkPanel" },
    "WebPanel": { "class": "equivalent", "catalogType": "WebPanel" },
    "Group": { "class": "equivalent", "catalogType": "SubTypeGroup" },
    "Procedure": { "class": "equivalent", "catalogType": "Procedure" },
    "DataView": { "class": "equivalent", "catalogType": "DataView" },
    "Menubar": { "class": "equivalent", "catalogType": "Menubar" },
    "Report": {
      "class": "orphan",
      "materializedFolderName": "Report",
      "typeToken": "gxlegacy/Report",
      "indexedByKbIntelligence": true,
      "modernSuccessor": "Procedure",
      "successorRelation": "absorbed"
    },
    "Menu": {
      "class": "orphan",
      "materializedFolderName": "Menu",
      "typeToken": "gxlegacy/Menu",
      "indexedByKbIntelligence": true,
      "modernSuccessor": null,
      "successorRelation": "none"
    },
    "Prompt": {
      "class": "orphan",
      "materializedFolderName": "Prompt",
      "typeToken": "gxlegacy/Prompt",
      "modernSuccessor": "WorkPanel",
      "successorRelation": "absorbed"
    },
    "Formula": {
      "class": "orphan",
      "materializedFolderName": "Formula",
      "typeToken": "gxlegacy/Formula",
      "modernSuccessor": "Attribute",
      "successorRelation": "absorbed"
    }
  }
}
